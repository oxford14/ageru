NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

PAYMENT_PROVIDER=starpago
STARPAGO_APP_ID=
STARPAGO_SECRET_KEY=
STARPAGO_API_HOST=https://api.starpago.com

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Comma-separated owner emails (promoted to super_admin on login)
OWNER_EMAIL=

# PanelFollows: use v3 with pf_live_ keys (https://panelfollows.com/en/api-docs)
PROVIDER_API_URL=https://panelfollows.com/api/v3
PROVIDER_API_KEY=
PROVIDER_API_VERSION=v3
PROVIDER_NAME=PanelFollows
PROVIDER_TOPUP_URL=https://panelfollows.com/addfunds
PROVIDER_CURRENCY=USD

# Optional: auth for /api/cron/* when using an external scheduler (not Vercel Cron)
CRON_SECRET=

# Required if you use legacy admin DB provider sync (openssl rand -base64 32)
ENCRYPTION_KEY=

BOOTSTRAP_ADMIN_EMAIL=
ALLOW_DEMO_SERVICES=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: PanelFollows API v3 webhooks (signing secret from panel → Webhooks tab)
PROVIDER_WEBHOOK_SECRET=

# Optional: 21st.dev component retrieval during development
API_KEY_21ST=
